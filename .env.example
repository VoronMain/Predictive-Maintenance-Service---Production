# Параметры приложения СПА. Скопируйте этот файл в .env и при
# необходимости отредактируйте значения. Файл .env не должен
# попадать в систему контроля версий.

# ------------------------------------------------------------ #
# Подсистема хранения данных.
# ------------------------------------------------------------ #
# Выбор бэкенда: postgres (производственный, PostgreSQL/TimescaleDB)
# либо sqlite (резервный, для автономной демонстрации и автотестов).
SPA_DB_BACKEND=postgres

# Параметры резервного бэкенда SQLite.
SPA_DB_PATH=./data/spa.db

# Параметры производственного бэкенда PostgreSQL/TimescaleDB.
SPA_PG_HOST=127.0.0.1
SPA_PG_PORT=5432
SPA_PG_DB=spa
SPA_PG_USER=spa
SPA_PG_PASSWORD=spa
# Глубина хранения (политики ретенции TimescaleDB), сут.
SPA_PG_RAW_RETENTION_DAYS=30
SPA_PG_AGG_RETENTION_DAYS=1825
# Возраст чанка для включения колоночного сжатия, сут.
SPA_PG_RAW_COMPRESS_AFTER_DAYS=7
SPA_PG_AGG_COMPRESS_AFTER_DAYS=30

# ------------------------------------------------------------ #
# Артефакты моделей, датасет, инференс.
# ------------------------------------------------------------ #
# Каталог с артефактами обученной модели (catboost, lightgbm, калибратор,
# model_config.json). По умолчанию (переменная не задана) приложение берёт
# каталог models/, вкомпилированный внутрь пакета predictive_maintenance в
# корне репозитория — этого достаточно и для Docker-образа, и для обычного
# локального запуска. Переменную стоит задавать явно только если нужен
# каталог с другими артефактами — например, внешний каталог Модели рядом с
# репозиторием на машине автора (пример ниже) либо путь, актуальный для
# другого расположения в контейнере.
# SPA_MODELS_DIR=../Модели/predictive_maintenance/models
SPA_DATASET_PATH=../Датасет/factory_sensor_simulator_2040.csv
SPA_AGGREGATION_WINDOW_SECONDS=3600
SPA_FAILURE_THRESHOLD=0.33

# ------------------------------------------------------------ #
# HTTP-сервис и аутентификация (HTTP Basic).
# ------------------------------------------------------------ #
SPA_API_HOST=0.0.0.0
SPA_API_PORT=8000
SPA_BASIC_AUTH_USER=admin
SPA_BASIC_AUTH_PASSWORD=admin
# Строгий режим: приложение отказывается стартовать, если логин или
# пароль совпадают с типовой заглушкой (admin, spa, пустое значение и
# т. п.). По умолчанию выключен — иначе локальный запуск и автотесты с
# дефолтными admin/admin перестанут работать. На публичном стенде
# (Railway) выставляется в true.
SPA_REQUIRE_STRONG_AUTH=false

# ------------------------------------------------------------ #
# Эмулятор источника телеметрии.
# ------------------------------------------------------------ #
# URL сервиса СПА, на который эмулятор шлёт измерения.
SPA_API_URL=http://127.0.0.1:8000
# Длительность одного цикла по всем 30 агрегатам, секунды.
SPA_EMULATOR_INTERVAL=120
# Максимальное ожидание готовности сервера при старте, секунды (0 — не ждать).
SPA_EMULATOR_STARTUP_TIMEOUT=120

# ------------------------------------------------------------ #
# Подсистема оповещений (email).
# ------------------------------------------------------------ #
# Режим работы: smtp (отправка через внешний сервер) или file
# (сохранение писем в data/alerts/ — для отладки и демонстрации).
SPA_SMTP_MODE=file
SPA_SMTP_HOST=
SPA_SMTP_PORT=587
SPA_SMTP_USER=
SPA_SMTP_PASSWORD=
SPA_SMTP_USE_TLS=true
SPA_SMTP_FROM=spa-alerts@example.local
SPA_SMTP_TO=maintenance@example.local
SPA_ALERTS_DIR=./data/alerts

# ------------------------------------------------------------ #
# Динамическое подавление повторов и группировка оповещений.
# ------------------------------------------------------------ #
# Базовое окно подавления повторов (минуты).
SPA_ALERT_COOLDOWN_MINUTES=30
# Дифференцированные окна подавления по степени критичности (минуты).
SPA_COOLDOWN_CRITICAL_MINUTES=5
SPA_COOLDOWN_HIGH_MINUTES=15
SPA_COOLDOWN_MEDIUM_MINUTES=30
# Пороги классификации степени критичности по вероятности отказа.
SPA_SEVERITY_CRITICAL_PROB=0.66
SPA_SEVERITY_HIGH_PROB=0.50
# Пороги эскалации по остаточному ресурсу (RUL, сут.).
SPA_SEVERITY_CRITICAL_RUL_DAYS=7
SPA_SEVERITY_HIGH_RUL_DAYS=14
# Окно групповой агрегации однотипных оповещений (group_wait, секунды).
SPA_ALERT_GROUP_WINDOW_SECONDS=60
