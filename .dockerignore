# Виртуальные окружения и кэш Python — переустанавливаются pip install
# внутри образа из requirements.txt, тащить локальный .venv незачем и
# вредно (чужая платформа/версия интерпретатора).
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Локальные данные рантайма (SQLite, письма-оповещения, логи) — образ
# должен быть без состояния предыдущих локальных запусков.
data/
*.db
*.sqlite3
server.log
*.log

# Секреты и локальная конфигурация — переменные окружения на платформе
# задаются отдельно, .env в образ попадать не должен.
.env
.env.local

# Git и рабочие материалы агента — не нужны в рантайме и раздувают
# контекст сборки.
.git/
.github/
.scratch/
.claude/
.agents/
.impeccable/

# ОС и редакторы.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Датасет и тяжёлые артефакты обучения — в рантайме не читаются (только
# вкомпилированные артефакты инференса predictive_maintenance/models/
# нужны и не подпадают под эту маску, т.к. это не CSV/parquet).
*.csv
*.parquet

# Тесты — используют TestClient/pytest, в образе рантайма не нужны;
# исключены и как самостоятельное дополнительное решение (спека это
# прямо допускает "по желанию"): pytest.ini не нужен без набора тестов,
# а сами тесты — это dev/CI-инструмент, не часть работающего сервиса.
tests/
pytest.ini
